import os
os.system("cls" if os.name == "nt" else "clear")

def dem_ky_tu(chuoi):
    dem = {}
    for ky_tu in chuoi:
        if ky_tu.isalpha():
            dem[ky_tu] = dem.get(ky_tu, 0) + 1
    return dem

chuoi = input("Nhập chuỗi: ")

for ky_tu, so_lan in dem_ky_tu(chuoi).items():
    print(f"Ký tự '{ky_tu}' xuất hiện {so_lan} lần.")

